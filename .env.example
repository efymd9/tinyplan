# TinyPlan — Environment Variables
#
# Production: copy to `.env.production` on the server, fill in real values, then
# build with it present (Next loads `.env.production` for `next build`/`next start`).
#   cp .env.example .env.production && nano .env.production
# Local dev: copy to `.env.local` instead.
#
# Legend:  [BUILD]  inlined at `next build` and frozen into the bundle (rebuild to change)
#          [RUN]    read at runtime by the server process
#          [PROD]   REQUIRED for a correct production deploy

# ── Core ─────────────────────────────────────────────────────────────────────

# [BUILD][PROD] Canonical https origin. Drives checkout/portal/logout links, the
# post-checkout reveal sign-up returnBackUrl in src/proxy.ts, the SEO metadataBase /
# canonical URLs (robots, sitemap, OG), and flips the session cookie Secure flag on.
# MUST be correct at build time (next.config.ts fails the build unless it is https).
NEXT_PUBLIC_APP_URL=https://tinyplan.org

# [RUN] `next start` sets this to "production" itself; setting it explicitly also
# guarantees the dev auth bypass can never activate. Keep "production" on the server.
NODE_ENV=production

# ── Auth — Clerk (production auth) ───────────────────────────────────────────
# Create a PRODUCTION instance at https://dashboard.clerk.com for tinyplan.org,
# add the DNS records it shows, then copy the live keys here. See DEPLOY.md.

# [BUILD][PROD] Publishable key — inlined into client+server bundles (rebuild to change).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
# [RUN][PROD] Secret key — read at request time; if missing, every route 500s.
CLERK_SECRET_KEY=sk_live_xxx

# [BUILD] Optional Clerk routing hints (read by the Clerk SDK, not our code).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard/today
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/today

# [RUN] Legacy magic-link JWT secret. Those routes are disabled while Clerk is on,
# but set a strong value anyway: `openssl rand -base64 48`. NEVER leave empty
# (the code falls back to a public dev string).
AUTH_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────

# [RUN][PROD] Comma-separated allowlist for the /admin dashboards. FAIL-CLOSED:
# empty = nobody can access /admin. Must match your Clerk account email.
ADMIN_EMAILS=you@example.com

# ── Payments — Stripe ────────────────────────────────────────────────────────
# Billing is fully BUILT but enforcement is OFF for soft launch. The webhook
# exists at POST /api/webhooks/stripe (signature-verified, idempotent payments
# rows, maps Stripe status -> subscription_status). The $1/7-days -> $14.99/mo
# model was validated in Stripe test mode with a test clock. See DEPLOY.md ->
# "Going live with real billing" for the full enable-billing runbook.

# [RUN] Real Stripe billing. When unset in production, checkout is disabled and
# throws — UNLESS DEV_BYPASS_PAYWALL=true (soft-launch mock pass-through).
STRIPE_SECRET_KEY=

# [RUN][PROD when STRIPE_SECRET_KEY is set] Webhook signing secret (whsec_...)
# from the Stripe dashboard endpoint for https://tinyplan.org/api/webhooks/stripe.
# REQUIRED whenever STRIPE_SECRET_KEY is set — startup preflight (instrumentation.ts)
# THROWS without it (signature verification, hence every subscription, would fail).
# Setting STRIPE_SECRET_KEY together with DEV_BYPASS_PAYWALL=true is also rejected
# at startup (live billing + open paywall is contradictory).
STRIPE_WEBHOOK_SECRET=

# [RUN] SOFT LAUNCH ONLY: with no Stripe key, true => checkout returns a mock URL
# that sends the user straight to the success page (no real charge, paywall open).
# Set true to launch the funnel without billing; REMOVE once Stripe is live.
DEV_BYPASS_PAYWALL=true

# ── Email — Resend (optional) ────────────────────────────────────────────────
# Clerk sends its own auth emails. The app's own transactional emails are currently
# unused, so this is optional. If enabled, EMAIL_FROM must be a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=TinyPlan <hello@tinyplan.org>

# ── Local development helpers (NEVER set in production) ───────────────────────
# DEV_BYPASS_AUTH=true   # returns a fixed signed-in user; ignored when NODE_ENV=production
# COOKIE_SECURE=false    # only if you intentionally serve plain HTTP (not recommended)

# ── Unused / not wired (present in older configs — safe to omit) ─────────────
# DATABASE_URL=                        # DB is local SQLite at ./data/tinyplan.db (not env-configurable)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # not read (checkout is a server-side redirect)
# NEXT_PUBLIC_POSTHOG_KEY=             # PostHog not integrated; analytics is first-party SQLite
# NEXT_PUBLIC_POSTHOG_HOST=
# AI_PROVIDER=                         # AI adapter is a stub; no provider wired
# OPENAI_API_KEY=
