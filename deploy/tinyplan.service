# TinyPlan production server (Next.js + better-sqlite3) under systemd.
# Mirrors the LIVE unit at /etc/systemd/system/tinyplan.service on the VPS.
# Install / restore:
#   sudo cp deploy/tinyplan.service /etc/systemd/system/tinyplan.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now tinyplan
# Logs: journalctl -u tinyplan -f

[Unit]
Description=TinyPlan Next.js app
After=network.target

[Service]
Type=simple

# CRITICAL: the app opens ./data/tinyplan.db relative to this directory, so it
# MUST be the app root on a persistent disk — otherwise a restart silently
# creates an empty DB elsewhere and "loses" all data.
WorkingDirectory=/root/parentpath

# Next loads .env.production from WorkingDirectory for both build and start.
# Keep secrets there (chmod 600).
Environment=NODE_ENV=production
EnvironmentFile=/root/parentpath/.env.production

# Port 3002 — 3000 is used by another app on this shared box. Caddy proxies here.
ExecStart=/usr/bin/npm run start -- -H 0.0.0.0 -p 3002

Restart=always
RestartSec=5

# Runs as root on this box, consistent with the other apps here. On a dedicated
# host, prefer a non-root service user that owns the app dir and ./data.
User=root

[Install]
WantedBy=multi-user.target
