# TinyPlan — Caddy vhost. These blocks are APPENDED to the SHARED
# /etc/caddy/Caddyfile (which serves other sites too) — do NOT replace the whole
# file. The shared file already has its own global `{ email … }` block.
#
# After editing the shared file:
#   cp -a /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak.$(date +%F-%H%M%S)
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   systemctl reload caddy          # if it sticks in "reloading": systemctl restart caddy
#
# Caddy obtains + auto-renews the Let's Encrypt cert once tinyplan.org's A record
# points at this server.
#
# NOTE: do NOT add a `log { output file … }` block pointing at a NEW file — the
# caddy user cannot create files in /var/log/caddy, so the reload fails with
# "permission denied" and the new config never applies. TinyPlan logs to journald
# (journalctl -u caddy).

tinyplan.org {
	encode zstd gzip
	# Edge abuse guard: reject multi-MB request bodies before they reach Node.
	# 1MB is far above any legit payload (quiz answers, checkout, Stripe webhook
	# events are all <<1MB) but blocks memory-pressure floods during ad traffic.
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:3002
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
}

# STATIC/IMAGE OFFLOAD — NOT done here on purpose. A Caddy `file_server` can't
# serve the assets: they live under /root (0700) which the `caddy` user can't
# read, and loosening /root would expose the 0644 SQLite DB. The app also serves
# images via the Next optimizer (/_next/image), and /_next/static is already
# immutable-cached. The real edge offload (cache /_next/image + /_next/static so
# cold visitors never hit Node) is a CDN job: put Cloudflare's free tier in front
# of tinyplan.org. If you do, set `trusted_proxies` here AND revisit
# src/lib/request-ip.ts (it assumes ONE trusted hop / rightmost XFF).

# Redirect www -> apex (needs a www A record pointing here; Caddy auto-certs it).
www.tinyplan.org {
	redir https://tinyplan.org{uri} permanent
}
