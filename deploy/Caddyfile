# TinyPlan — Caddy vhost. These blocks are APPENDED to the SHARED
# /etc/caddy/Caddyfile (which serves other sites too) — do NOT replace the whole
# file. The shared file already has its own global `{ email … }` block.
#
# After editing the shared file:
#   cp -a /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak.$(date +%F-%H%M%S)
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   systemctl reload caddy          # if it sticks in "reloading": systemctl restart caddy
#
# Caddy obtains + auto-renews the Let's Encrypt cert once tinyplan.org's A record
# points at this server.
#
# NOTE: do NOT add a `log { output file … }` block pointing at a NEW file — the
# caddy user cannot create files in /var/log/caddy, so the reload fails with
# "permission denied" and the new config never applies. TinyPlan logs to journald
# (journalctl -u caddy).

tinyplan.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3002
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
}

# Redirect www -> apex (needs a www A record pointing here; Caddy auto-certs it).
www.tinyplan.org {
	redir https://tinyplan.org{uri} permanent
}
